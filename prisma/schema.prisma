generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  PHYSICIAN
  READ_ONLY
}

enum ConsultationType {
  AGA_INITIAL
  FOLLOW_UP
}

enum ConsultationStatus {
  DRAFT
  IN_REVIEW
  FINALIZED
}

enum ProblemType {
  CLINICAL
  GERIATRIC
}

enum ProblemStatus {
  ACTIVE
  STABLE
  MONITORING
  RESOLVED
}

enum DocumentType {
  SOAP
  FAMILY_REPORT
  MEDICATION_PLAN
  AGA_REPORT
}

enum DigitalSignatureStatus {
  PENDING
  SIGNED
  FAILED
}

enum MedicationStatus {
  ACTIVE
  SUSPENDED
  FINISHED
}

enum MedicationMoment {
  MORNING
  LUNCH
  AFTERNOON
  EVENING
  BEDTIME
  AS_NEEDED
}

enum PatientIdentifierType {
  CPF
  CNS
  MEDICAL_RECORD
  OTHER
}

enum Program55EnrollmentStatus {
  ACTIVE
  COMPLETED
  ENDED
}

enum Program55CheckpointType {
  BASELINE
  DAY_90
  DAY_180
  YEAR_1
  CUSTOM
}

enum Program55WorkflowStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

enum Program55ProfessionalDiscipline {
  PHYSICIAN
  PHYSIOTHERAPY
  NUTRITION
  PSYCHOLOGY
}

enum Program55GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String
  image         String?
  role          UserRole       @default(PHYSICIAN)
  active        Boolean        @default(true)
  consultations Consultation[]
  documents     DocumentSnapshot[] @relation("FinalizedDocuments")
  generatedDocuments DocumentSnapshot[] @relation("GeneratedDocuments")
  digitalSignatures DigitalSignature[]
  integrationCredentials ExternalIntegrationCredential[]
  auditEvents   AuditEvent[]
  advanceDirectiveRecords AdvanceDirectiveRecord[]
  program55CoordinatedEnrollments Program55Enrollment[] @relation("Program55Coordinator")
  program55Memberships Program55ProfessionalMembership[]
  program55Assessments Program55ProfessionalAssessment[] @relation("Program55AssessmentAuthor")
  program55BodyCompositionRecords Program55BodyComposition[] @relation("Program55BodyCompositionAuthor")
  program55Goals Program55Goal[] @relation("Program55GoalAuthor")
  program55RestrictedPsychologyNotes Program55RestrictedPsychologyNote[] @relation("Program55RestrictedNoteAuthor")
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.LongText
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Patient {
  id                     String              @id @default(cuid())
  fullName               String
  normalizedFullName     String
  identityFingerprint    String
  homonymDiscriminator   String              @default("primary")
  needsIdentityReview    Boolean             @default(false)
  birthDate              DateTime?
  sex                    String?
  education              String?
  phone                  String?
  caregiverName          String?
  caregiverPhone         String?
  baselineConsultationId String?             @unique
  baselineConsultation   Consultation?       @relation("PatientBaseline", fields: [baselineConsultationId], references: [id], onDelete: SetNull)
  consultations          Consultation[]      @relation("PatientConsultations")
  problems               ClinicalProblem[]
  scaleAssessments       ScaleAssessment[]
  clinicalExamRecords    ClinicalExamRecord[]
  medications            Medication[]
  documents              DocumentSnapshot[]
  digitalSignatures      DigitalSignature[]
  advanceDirectiveRecords AdvanceDirectiveRecord[]
  identifiers            PatientIdentifier[]
  program55Enrollment    Program55Enrollment?
  program55Checkpoints   Program55Checkpoint[]
  program55BodyComposition Program55BodyComposition[]
  program55ProfessionalAssessments Program55ProfessionalAssessment[]
  program55Goals         Program55Goal[]
  program55RestrictedPsychologyNotes Program55RestrictedPsychologyNote[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([identityFingerprint, homonymDiscriminator])
  @@index([normalizedFullName, birthDate])
}

model PatientIdentifier {
  id              String                @id @default(cuid())
  patientId       String
  type            PatientIdentifierType
  value           String
  normalizedValue String
  patient         Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())

  @@unique([type, normalizedValue])
  @@index([patientId])
}

model Consultation {
  id                String              @id @default(cuid())
  patientId         String
  physicianId       String
  type              ConsultationType
  status            ConsultationStatus  @default(DRAFT)
  occurredAt        DateTime
  subjective        Json?
  objective         Json?
  assessment        Json?
  plan              Json?
  patient           Patient             @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Restrict)
  physician         User                @relation(fields: [physicianId], references: [id], onDelete: Restrict)
  baselineFor       Patient?            @relation("PatientBaseline")
  problemsOriginated ClinicalProblem[]  @relation("ProblemOrigin")
  problemEvents     ProblemEvent[]
  scaleAssessments  ScaleAssessment[]
  clinicalExamRecord ClinicalExamRecord?
  medicationRegimens MedicationRegimen[]
  medicationStatusEvents MedicationStatusEvent[]
  documents         DocumentSnapshot[]
  digitalSignatures DigitalSignature[]
  advanceDirectiveRecords AdvanceDirectiveRecord[]
  program55Checkpoints Program55Checkpoint[] @relation("Program55CoordinatingConsultation")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([patientId, occurredAt])
  @@index([physicianId, occurredAt])
  @@unique([id, patientId])
}

model AdvanceDirectiveRecord {
  id                  String       @id @default(cuid())
  patientId           String
  consultationId      String
  recordedById        String
  version             Int
  protocolVersion     String
  disposition         String
  participationMode   String?
  trustedPersonName   String?
  trustedRelation     String?
  trustedContact      String?
  whatMatters         String?      @db.Text
  dignityAndComfort   String?      @db.Text
  priorities          Json
  topics              Json
  documentStatus      String
  reviewTrigger       String
  patient             Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation        Consultation @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  recordedBy          User         @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt           DateTime     @default(now())

  @@unique([consultationId, version])
  @@index([patientId, createdAt])
  @@index([recordedById, createdAt])
}

model ClinicalExamRecord {
  id             String       @id @default(cuid())
  patientId      String
  consultationId String       @unique
  content        String       @db.LongText
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation   Consultation @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([patientId, updatedAt])
  @@unique([consultationId, patientId])
}

model ClinicalProblem {
  id                   String         @id @default(cuid())
  patientId            String
  originConsultationId String
  type                 ProblemType
  status               ProblemStatus  @default(ACTIVE)
  title                String
  description          String?        @db.Text
  priority             Int?
  resolvedAt           DateTime?
  patient              Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  originConsultation   Consultation   @relation("ProblemOrigin", fields: [originConsultationId, patientId], references: [id, patientId], onDelete: Restrict)
  events               ProblemEvent[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId, status])
  @@index([patientId, type])
  @@unique([id, patientId])
}

model ProblemEvent {
  id             String         @id @default(cuid())
  problemId      String
  patientId      String
  consultationId String
  previousStatus ProblemStatus?
  newStatus      ProblemStatus
  note           String?        @db.Text
  problem        ClinicalProblem @relation(fields: [problemId, patientId], references: [id, patientId], onDelete: Restrict)
  consultation   Consultation    @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  createdAt      DateTime        @default(now())

  @@index([problemId, createdAt])
}

model ScaleDefinition {
  id           String            @id @default(cuid())
  code         String
  version      String
  name         String
  dimension    String?
  sourceStatus String
  sourceCitation String?          @db.Text
  sourceNote   String?            @db.Text
  interpretationConfig Json?
  interventionConfig Json?
  definitionHash String?
  reviewedAt   DateTime?
  config       Json
  isActive     Boolean           @default(true)
  assessments  ScaleAssessment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([code, version])
  @@index([code, isActive])
}

model ScaleAssessment {
  id             String       @id @default(cuid())
  scaleDefinitionId String?
  patientId      String
  consultationId String
  scaleCode      String
  scaleVersion   String
  answers        Json
  scoreNumeric   Decimal?     @db.Decimal(10, 2)
  scoreText      String?
  classification String?
  interpretation String?      @db.Text
  clinicalColor  String?
  scaleDefinition ScaleDefinition? @relation(fields: [scaleDefinitionId], references: [id], onDelete: Restrict)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation   Consultation @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  appliedAt      DateTime     @default(now())

  @@index([patientId, scaleCode, appliedAt])
  @@index([scaleDefinitionId])
  @@index([consultationId])
}

model Medication {
  id          String           @id @default(cuid())
  patientId   String
  name        String
  presentation String?
  route       String?
  status      MedicationStatus @default(ACTIVE)
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  regimens    MedicationRegimen[]
  statusEvents MedicationStatusEvent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([patientId, status])
  @@unique([id, patientId])
}

model MedicationRegimen {
  id             String       @id @default(cuid())
  medicationId   String
  patientId      String
  consultationId String
  dose           String?
  frequency      String?
  schedule       Json?
  route          String?
  continuous     Boolean      @default(false)
  needsScheduleReview Boolean @default(false)
  instructions   String?      @db.Text
  startsAt       DateTime?
  endsAt         DateTime?
  medication     Medication   @relation(fields: [medicationId, patientId], references: [id, patientId], onDelete: Restrict)
  consultation   Consultation @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  scheduleSlots  MedicationScheduleSlot[]
  createdAt      DateTime     @default(now())

  @@index([consultationId])
}

model MedicationScheduleSlot {
  id        String           @id @default(cuid())
  regimenId String
  moment    MedicationMoment
  regimen   MedicationRegimen @relation(fields: [regimenId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())

  @@unique([regimenId, moment])
  @@index([moment])
}

model MedicationStatusEvent {
  id             String           @id @default(cuid())
  medicationId   String
  patientId      String
  consultationId String
  previousStatus MedicationStatus?
  newStatus      MedicationStatus
  medication     Medication       @relation(fields: [medicationId, patientId], references: [id, patientId], onDelete: Restrict)
  consultation   Consultation     @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  createdAt      DateTime         @default(now())

  @@index([medicationId, patientId, createdAt])
  @@index([consultationId, patientId])
}

model DocumentSnapshot {
  id             String       @id @default(cuid())
  patientId      String
  consultationId String
  type           DocumentType
  version        Int
  content        Json
  contentSchemaVersion String @default("1.0")
  sourceConsultationStatus ConsultationStatus
  generatedById  String?
  finalizedAt    DateTime?
  finalizedById  String?
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation   Consultation @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  finalizedBy    User?        @relation("FinalizedDocuments", fields: [finalizedById], references: [id], onDelete: SetNull)
  generatedBy    User?        @relation("GeneratedDocuments", fields: [generatedById], references: [id], onDelete: SetNull)
  digitalSignatures DigitalSignature[]
  createdAt      DateTime     @default(now())

  @@unique([consultationId, type, version])
  @@index([patientId, createdAt])
}

model DigitalSignature {
  id                    String                 @id @default(cuid())
  patientId             String
  consultationId        String
  sourceSnapshotId      String
  createdById           String
  provider              String                 @default("VIDAAS")
  status                DigitalSignatureStatus @default(PENDING)
  unsignedPdfBase64     String?                @db.LongText
  signedPdfBase64       String?                @db.LongText
  unsignedSha256        String
  signedSha256          String?
  verificationTokenHash String                 @unique
  oauthStateHash        String                 @unique
  signatureFormat       String                 @default("PAdES_AD_RB")
  certificateAlias      String?
  errorCode             String?
  expiresAt             DateTime
  signedAt              DateTime?
  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation          Consultation           @relation(fields: [consultationId, patientId], references: [id, patientId], onDelete: Restrict)
  sourceSnapshot        DocumentSnapshot       @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  createdBy             User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([consultationId, createdAt])
  @@index([patientId, createdAt])
  @@index([sourceSnapshotId])
  @@index([createdById, createdAt])
  @@index([status, expiresAt])
}

model ExternalIntegrationCredential {
  id               String   @id @default(cuid())
  provider         String   @unique
  encryptedPayload String   @db.LongText
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdById, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  entityType String
  entityId   String
  action     String
  requestId  String?
  outcome    String?
  reasonCode String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
}

model Program55Enrollment {
  id                      String                    @id @default(cuid())
  patientId               String                    @unique
  status                  Program55EnrollmentStatus @default(ACTIVE)
  startedAt               DateTime
  endedAt                 DateTime?
  coordinatingPhysicianId String?
  patient                 Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  coordinatingPhysician   User?                     @relation("Program55Coordinator", fields: [coordinatingPhysicianId], references: [id], onDelete: SetNull)
  checkpoints             Program55Checkpoint[]
  goals                   Program55Goal[]
  memberships             Program55ProfessionalMembership[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([status, startedAt])
  @@index([coordinatingPhysicianId])
}

model Program55Checkpoint {
  id                       String                   @id @default(cuid())
  enrollmentId             String
  patientId                String
  checkpointType           Program55CheckpointType
  referenceDate            DateTime
  status                   Program55WorkflowStatus @default(NOT_STARTED)
  coordinatingConsultationId String?
  enrollment               Program55Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  patient                  Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  coordinatingConsultation Consultation?            @relation("Program55CoordinatingConsultation", fields: [coordinatingConsultationId, patientId], references: [id, patientId], onDelete: Restrict)
  bodyComposition          Program55BodyComposition[]
  professionalAssessments  Program55ProfessionalAssessment[]
  goals                    Program55Goal[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([enrollmentId, checkpointType, referenceDate])
  @@index([patientId, referenceDate])
  @@index([status, referenceDate])
  @@index([coordinatingConsultationId, patientId])
}

model Program55ProfessionalMembership {
  id           String                          @id @default(cuid())
  enrollmentId String
  userId       String
  discipline   Program55ProfessionalDiscipline
  active       Boolean                         @default(true)
  enrollment   Program55Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  user         User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt

  @@unique([enrollmentId, userId, discipline])
  @@index([userId, active])
  @@index([enrollmentId, discipline, active])
}

model Program55BodyComposition {
  id               String    @id @default(cuid())
  checkpointId     String
  patientId        String
  measuredAt       DateTime
  weightKg         Decimal?  @db.Decimal(7, 2)
  heightCm         Decimal?  @db.Decimal(6, 2)
  bmi              Decimal?  @db.Decimal(6, 2)
  waistCm          Decimal?  @db.Decimal(6, 2)
  bodyFatPercent   Decimal?  @db.Decimal(6, 2)
  fatMassKg        Decimal?  @db.Decimal(7, 2)
  fatFreeMassKg    Decimal?  @db.Decimal(7, 2)
  muscleMassKg     Decimal?  @db.Decimal(7, 2)
  additionalMetrics Json?
  sourceLabel      String?
  deviceLabel      String?
  notes            String?   @db.Text
  createdById      String
  checkpoint       Program55Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy        User      @relation("Program55BodyCompositionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([checkpointId, measuredAt])
  @@index([patientId, measuredAt])
  @@index([createdById, createdAt])
}

model Program55ProfessionalAssessment {
  id             String                          @id @default(cuid())
  checkpointId   String
  patientId      String
  discipline     Program55ProfessionalDiscipline
  status         Program55WorkflowStatus         @default(IN_PROGRESS)
  structuredData Json?
  sharedSummary  String?                         @db.Text
  authorUserId   String
  assessedAt     DateTime                        @default(now())
  checkpoint     Program55Checkpoint             @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  patient        Patient                         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author         User                            @relation("Program55AssessmentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  restrictedPsychologyNote Program55RestrictedPsychologyNote?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  @@unique([checkpointId, discipline])
  @@index([patientId, assessedAt])
  @@index([authorUserId, assessedAt])
  @@index([discipline, status])
}

model Program55RestrictedPsychologyNote {
  id             String   @id @default(cuid())
  assessmentId   String   @unique
  patientId      String
  authorUserId   String
  content        String   @db.LongText
  assessment     Program55ProfessionalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author         User     @relation("Program55RestrictedNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([authorUserId, createdAt])
}

model Program55Goal {
  id                    String                          @id @default(cuid())
  enrollmentId          String
  checkpointId          String?
  patientId             String
  domain                String
  objective             String                          @db.Text
  indicator             String?
  baselineValue         String?
  targetValue           String?
  dueDate               DateTime?
  status                Program55GoalStatus             @default(ACTIVE)
  responsibleDiscipline Program55ProfessionalDiscipline?
  notes                 String?                         @db.Text
  createdById           String
  enrollment            Program55Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  checkpoint            Program55Checkpoint?            @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  patient               Patient                         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy             User                            @relation("Program55GoalAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  @@index([enrollmentId, status, dueDate])
  @@index([patientId, createdAt])
  @@index([checkpointId])
  @@index([createdById, createdAt])
}
