# Nunca commitar credenciais reais.
NODE_ENV="development"
APP_URL="http://localhost:3000"
DATABASE_URL="mysql://prontuario_user:trocar_senha@127.0.0.1:3306/prontuario"

# Gere um segredo aleatório forte (>= 32 caracteres) para cada ambiente.
BETTER_AUTH_SECRET="trocar-por-segredo-aleatorio-com-32-ou-mais-caracteres"
GOOGLE_CLIENT_ID="trocar.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="trocar"

# Lista fechada. Não existe cadastro público.
AUTH_ALLOWED_EMAILS="medica1@example.com,medica2@example.com"
# Precisa ser subconjunto da allowlist e conter ao menos um e-mail em produção.
AUTH_BOOTSTRAP_ADMIN_EMAILS="medica1@example.com"
# Opcional: e-mail exato do perfil que pode usar a marca pessoal Natalia Mendes.
# Se ausente, a aplicação usa o nome autenticado "Natalia Mendes" como fallback de compatibilidade.
PROFESSIONAL_BRAND_OWNER_EMAIL=""

# Integração VIDaaS. Nunca coloque client_secret no bundle do navegador.
# Homologação oficial: https://hml-certificado.vidaas.com.br
# Produção oficial: https://certificado.vidaas.com.br
VIDAAS_BASE_URL="https://hml-certificado.vidaas.com.br"
VIDAAS_CLIENT_ID=""
VIDAAS_CLIENT_SECRET=""
# Deve coincidir exatamente com uma redirect URI cadastrada na aplicação VIDaaS.
# Em branco, usa ${APP_URL}/api/signatures/vidaas/callback.
VIDAAS_REDIRECT_URI=""
# Formatos aceitos pelo Prontuário: PAdES_AD_RB ou PAdES_AD_RT.
VIDAAS_SIGNATURE_FORMAT="PAdES_AD_RB"

# Chave AES-256 para backup criptografado. Gere 32 bytes aleatórios e armazene apenas no ambiente seguro.
BACKUP_ENCRYPTION_KEY_B64="trocar-por-base64-de-32-bytes"
# Opcional: caminho do mysqldump quando o binário não estiver no PATH.
MYSQLDUMP_BIN="mysqldump"

# Licenças/permissões para reprodução eletrônica de instrumentos protegidos.
# Mantenha false até possuir evidência documental aplicável; nunca use estas flags para presumir autorização.
CLINICAL_LICENSE_MNA_EHR_CONFIRMED="false"
CLINICAL_LICENSE_MMSE_ELECTRONIC_CONFIRMED="false"
CLINICAL_LICENSE_MOCA_ELECTRONIC_CONFIRMED="false"
